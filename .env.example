# ==============================================================================
# Apiapia — environment template
#
#   cp .env.example .env
#
# Every variable below is optional except POSTGRES_PASSWORD. Anything left unset
# falls back to the default in backend/app/core/config.py, which is the same
# value shown here — so you only need to touch the lines you actually want to
# change, and deleting a line is equivalent to setting it to its default.
#
# Regenerate secrets (do not reuse the samples below):
#   SECRET_KEY              python -c "import secrets;print(secrets.token_urlsafe(48))"
#   API_KEY_ENCRYPTION_KEY  python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL — the password is the only value here that MUST be set
# ------------------------------------------------------------------------------
# The database DSNs are assembled from these. Leave DATABASE_URL and
# MEM0_DATABASE_URL empty; set them only if the app must talk to a database other
# than the one this compose file starts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=apiapia
# Service name on the compose network. Change only if you rename the service.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL=
# MEM0_DATABASE_URL=

# Host port mappings, so a deployment can move off the defaults when the host
# already uses them.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ------------------------------------------------------------------------------
# Security — replace both before exposing the deployment
# ------------------------------------------------------------------------------
# Signs JWTs. Rotating it logs everyone out.
SECRET_KEY=change-this-to-a-super-secret-jwt-key-min-32-chars-long
# Fernet key encrypting the API keys stored in the database. Rotating it makes
# every already-stored key undecryptable and users must re-enter them.
API_KEY_ENCRYPTION_KEY=dGhpc2lzYTMyeWVhcnNvbGRzZWNyZXRrZXkxMjM0NTY=

# JWT lifetime in minutes (default 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Grant admin on registration. Strongly recommended for a public deployment —
# otherwise the first account to register becomes the admin.
# ADMIN_EMAIL=
# ADMIN_USERNAME=

# ------------------------------------------------------------------------------
# Default chat model for new accounts — users can switch per conversation
# ------------------------------------------------------------------------------
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_PROVIDER=openai

# ------------------------------------------------------------------------------
# Provider credentials
#
# These are deployment-wide fallbacks. A user who saves a key in the settings page
# overrides them for their own account, so leaving a key blank here does not stop
# a deployment from working — it only means nobody has a working provider until
# someone configures one.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# One key covers chat, embeddings, STT and TTS across 200+ models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=

# Leave empty to disable Ollama. From inside a container the host is reachable
# as host.docker.internal (see extra_hosts in docker-compose.yml).
OLLAMA_BASE_URL=

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ------------------------------------------------------------------------------
# Web search — blank falls back to the free DuckDuckGo scraper
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
# advanced = more thorough, slower, more expensive; basic = the opposite.
TAVILY_SEARCH_DEPTH=advanced
# Tavily bills include_answer separately. It is injected into the system prompt
# as a cross-checkable hint; set False to save the surcharge.
TAVILY_INCLUDE_ANSWER=True

# ------------------------------------------------------------------------------
# Image generation
# ------------------------------------------------------------------------------
# auto picks from the models the account can actually afford.
IMAGE_GEN_PROVIDER=auto
IMAGE_GEN_MODEL=dall-e-3
# Comma-separated zero-cost models, tried in order for accounts without paid
# access. A failure here never falls back to a paid model.
FREE_IMAGE_MODELS=inclusionai/ming-image-0.1-design

# ------------------------------------------------------------------------------
# Video generation
# ------------------------------------------------------------------------------
VIDEO_GEN_PROVIDER=auto
VIDEO_GEN_MODEL=
FREE_VIDEO_MODELS=

# ------------------------------------------------------------------------------
# Speech
#
# The models themselves are NOT configured here. Users pick STT and TTS in the
# settings page, which stores them in user_settings.stt_model / tts_model and
# /speech/* resolves them per account. An env var could only be a global override
# that silently contradicts what each user selected.
# ------------------------------------------------------------------------------
# Comma-separated zero-cost audio models, tried in order.
FREE_AUDIO_MODELS=
# Pin one voice across the whole deployment. Leave empty to use the first voice
# the model's catalog reports. A value the model rejects is ignored, not an error.
TTS_VOICE=
# Upload ceiling for speech-to-text; OpenRouter's own multipart cap is 25 MB.
SPEECH_MAX_AUDIO_BYTES=26214400
# Synthesis ceiling per request; the frontend splits longer replies.
SPEECH_MAX_TEXT_CHARS=4000

# ------------------------------------------------------------------------------
# Storage — the paths must match the volumes mounted in docker-compose.yml
# ------------------------------------------------------------------------------
MEM0_DATA_DIR=/app/data/mem0
MEDIA_DIR=/app/data/media

# ------------------------------------------------------------------------------
# Frontend & CORS
# ------------------------------------------------------------------------------
# Leave empty to use the same-origin /api/backend proxy that ships with the Node
# server: no server IP to configure, no CORS. Set it ONLY for the static-export
# (Cloudflare Pages) path, where that proxy does not exist and the browser must
# call the backend directly — and then the backend CORS policy must allow the
# frontend's domain.
NEXT_PUBLIC_API_URL=

# Where the frontend container reaches the backend. Compose-network internal.
INTERNAL_API_URL=http://backend:8000/api

# Comma-separated list of origins allowed by backend CORS.
# Defaults to "http://localhost:3000,http://127.0.0.1:3000".
# Set this to your frontend URL if you deploy frontend on an external domain.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
# CORS_ORIGIN_REGEX=^https://([a-zA-Z0-9-]+\.)*apiapia\.com$