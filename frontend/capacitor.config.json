{
  "appId": "com.personalai.assistant",
  "appName": "Personal AI",
  "webDir": "public",
  "server": {
    "cleartext": true,
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#090d16"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  },
  "ios": {
    "contentInset": "always",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  }
}
